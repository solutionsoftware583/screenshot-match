# Copy to .env for local development. Placeholders only — never commit real values.
# On Lovable Cloud these are provided automatically.
VITE_SUPABASE_URL=https://your-project.example
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=your-project-id
# Server-only (never prefix with VITE_):
SUPABASE_URL=https://your-project.example
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# SUPABASE_SERVICE_ROLE_KEY is injected by the platform on trusted servers only.
